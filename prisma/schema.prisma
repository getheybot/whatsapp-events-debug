generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WhatsappEvent {
  id         BigInt    @id @default(autoincrement())
  wamid      String    @db.VarChar(131)
  eventName  String    @map("event_name") @db.VarChar(36)
  code       BigInt    @map("code")
  category   String?   @db.VarChar(16)
  content    Json?     @db.Json
  eventAt    DateTime  @map("event_at") @db.Timestamp(0)
  createdAt  DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)

  @@map("whatsapp_events")
  @@index([eventAt(sort: Desc)])
  @@index([wamid])
  @@index([eventName])
}
